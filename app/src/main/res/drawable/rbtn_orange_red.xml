            <solid android:color="@color/orange_red"/>

            <stroke android:width="1dp" android:color="@color/orange_red"/>

            <!--<padding android:left="@dimen/rbtn_padding" android:top="@dimen/rbtn_padding"-->
                     <!--android:right="@dimen/rbtn_padding" android:bottom="@dimen/rbtn_padding" />-->

            <!--<corners android:bottomRightRadius="@dimen/rbtn_corner_radius" android:bottomLeftRadius="@dimen/rbtn_corner_radius"-->
                     <!--android:topLeftRadius="@dimen/rbtn_corner_radius" android:topRightRadius="@dimen/rbtn_corner_radius" />-->

        </shape>
    </item>

</selector>