<?xml version="1.0" encoding="utf-8"?>
<!--
    Native sign-up form. Two fields per row; only Name and Address use the full width.
    Every field has a label above a white rounded box; dropdowns list only real values.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_registration"
                android:textColor="@color/text_color_primary"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSignUpError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/orange_red"
                android:textSize="@dimen/text_size_small"
                android:visibility="gone" />

            <!-- Name (full width) -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/lbl_name_required" />

            <EditText
                android:id="@+id/input_name"
                style="@style/FormInput"
                android:inputType="textPersonName|textCapWords" />

            <!-- Email | Mobile number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/FormColumnStart">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_email_required" />

                    <EditText
                        android:id="@+id/input_email"
                        style="@style/FormInput"
                        android:inputType="textEmailAddress" />
                </LinearLayout>

                <LinearLayout style="@style/FormColumnEnd">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_mobile_required" />

                    <EditText
                        android:id="@+id/input_phone"
                        style="@style/FormInput"
                        android:digits="0123456789"
                        android:hint="@string/hint_digits_only"
                        android:inputType="number"
                        android:maxLength="15" />
                </LinearLayout>
            </LinearLayout>

            <!-- Address (full width, optional) -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/lbl_address_optional" />

            <EditText
                android:id="@+id/input_address"
                style="@style/FormInput"
                android:gravity="top|start"
                android:hint="@string/hint_address"
                android:inputType="textPostalAddress|textMultiLine|textCapWords"
                android:maxLength="500"
                android:minLines="2" />

            <!-- Candidate Type | Medical College -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/FormColumnStart">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_candidate_type" />

                    <FrameLayout style="@style/FormSpinnerBox">

                        <Spinner
                            android:id="@+id/spCategory"
                            style="@style/FormSpinner" />

                        <ImageView style="@style/FormSpinnerArrow" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout style="@style/FormColumnEnd">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_medical_college" />

                    <FrameLayout style="@style/FormSpinnerBox">

                        <Spinner
                            android:id="@+id/spMedicalCollege"
                            style="@style/FormSpinner" />

                        <ImageView style="@style/FormSpinnerArrow" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Faculty | Subject -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/FormColumnStart">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_faculty" />

                    <FrameLayout style="@style/FormSpinnerBox">

                        <Spinner
                            android:id="@+id/spFaculty"
                            style="@style/FormSpinner" />

                        <ImageView style="@style/FormSpinnerArrow" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout style="@style/FormColumnEnd">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_subject" />

                    <FrameLayout style="@style/FormSpinnerBox">

                        <Spinner
                            android:id="@+id/spDepartment"
                            style="@style/FormSpinner" />

                        <ImageView style="@style/FormSpinnerArrow" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Batch Name | Remarks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/FormColumnStart">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_batch_name" />

                    <FrameLayout style="@style/FormSpinnerBox">

                        <Spinner
                            android:id="@+id/spBatch"
                            style="@style/FormSpinner" />

                        <ImageView style="@style/FormSpinnerArrow" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout style="@style/FormColumnEnd">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_remarks_optional" />

                    <EditText
                        android:id="@+id/input_remarks"
                        style="@style/FormInput"
                        android:inputType="textCapSentences" />
                </LinearLayout>
            </LinearLayout>

            <!-- Password | Confirm password (eye icon shows or hides the text) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/FormColumnStart">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_password_required" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_color_secondary"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/input_password"
                            style="@style/FormInput"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout style="@style/FormColumnEnd">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/lbl_password_re_required" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_color_secondary"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/input_password_re"
                            style="@style/FormInput"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegister"
                style="@style/buttonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="12dp"
                android:text="@string/btn_register" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
