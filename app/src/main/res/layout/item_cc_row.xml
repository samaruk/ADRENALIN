<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable row with a picture, a title, a subtitle and a chevron (courses of Course Plan, subjects of Lectures) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/cc_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/row_picture_box"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp">

            <ImageView
                android:id="@+id/row_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_banner"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/row_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/cc_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cc_slate"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/row_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cc_chevron" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
