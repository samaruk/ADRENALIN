<?xml version="1.0" encoding="utf-8"?>
<!-- A white card with a heading and a block of text (lecture overview, content and notes; About Us sections) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/cc_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cc_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_card_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/cc_body"
            android:textColorLink="@color/cc_teal"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
